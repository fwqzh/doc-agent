# Native Windows local-test configuration. Do not use these defaults in production.
DEPLOYMENT_VERSION=speed
DOCKER_ENVIRONMENT=false

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_DB=nexent
NEXENT_POSTGRES_PASSWORD=nexent@4321

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_BACKEND_URL=redis://127.0.0.1:6379/1
RUNTIME_STATE_REDIS_URL=redis://127.0.0.1:6379/0

ELASTICSEARCH_HOST=http://127.0.0.1:9200
ELASTICSEARCH_API_KEY=
ELASTIC_PASSWORD=

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=nexent
MINIO_SECRET_KEY=nexent@4321
MINIO_ROOT_USER=nexent
MINIO_ROOT_PASSWORD=nexent@4321
MINIO_REGION=cn-north-1
MINIO_DEFAULT_BUCKET=nexent
MINIO_SECURE=false

CONFIG_SERVICE_URL=http://127.0.0.1:5010
RUNTIME_SERVICE_URL=http://127.0.0.1:5014
ELASTICSEARCH_SERVICE=http://127.0.0.1:5010/api
NEXENT_MCP_SERVER=http://127.0.0.1:5011
MCP_MANAGEMENT_API=http://127.0.0.1:5015
DATA_PROCESS_SERVICE=http://127.0.0.1:5012/api
NORTHBOUND_API_SERVER=http://127.0.0.1:5013/api

HTTP_BACKEND=http://127.0.0.1:5010
RUNTIME_HTTP_BACKEND=http://127.0.0.1:5014
WS_BACKEND=ws://127.0.0.1:5014

NEXENT_SANDBOX_DEFAULT_LEVEL=local
NEXENT_SANDBOX_SHELL_POLICY=disabled
NEXENT_SANDBOX_NETWORK=disabled
NEXENT_SANDBOX_AUTO_SYNC_OUTPUTS=true

DISABLE_RAY_DASHBOARD=true
DISABLE_CELERY_FLOWER=true
REDIS_PORT=6379
RAY_OBJECT_STORE_MEMORY_GB=0.25
LOG_LEVEL=INFO

# These paths are updated by deploy-windows-native.ps1.
ROOT_DIR=
LOG_DIR=
SKILLS_PATH=
OFFICIAL_SKILLS_ZIP_PATH=
MEMORY_PROVIDER_PLUGINS_DIR=
AGENT_WORKSPACE_ROOT=
ALLOWED_SKILL_UPLOAD_ROOT=
UPLOAD_FOLDER=
LIBREOFFICE_PROFILE_DIR=
RAY_TEMP_DIR=
